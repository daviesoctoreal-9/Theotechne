{
  "buildCommand": "vite build && esbuild api-src/index.ts --platform=node --bundle --format=esm --outfile=api/index.js --packages=external",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}